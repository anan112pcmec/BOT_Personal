# Ambil key gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=isi_key_lu_di_sini

# (opsional) nomor WA bot, biar gak ditanya tiap pairing. Format 62xxx
# PHONE_NUMBER=62812xxxxxxx

# (opsional) model teks yang dicoba berurutan
# GEMINI_MODELS=gemini-3.8-flash,gemini-2.5-flash

# (opsional) true kalo bot jalan di nomor lu sendiri & mau manggil dari HP itu juga
# ALLOW_SELF=true

# (opsional) debug Baileys: warn / info / debug
# LOG_LEVEL=error

# (opsional) model bikin/edit gambar, dicoba berurutan
# GEMINI_IMAGE_MODELS=gemini-2.5-flash-image
